{
  "$schema": "https://turborepo.org/schema.json",
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    // Workaround for https://github.com/jetify-com/devbox/issues/1415
    "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS",
    // Env vars provided by devbox
    "DEVBOX_*",
    "NIX_*",
    "PHP*",
    "NODE_*",
    "HOST_PATH"
  ],
  "globalDependencies": [
    // devbox
    "devbox.json",
    "devbox.lock",
    "devbox.d/**",
    // direnv
    ".envrc",
    // pnpm
    ".npmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["prep"]
    },
    "prep": {
      "dependsOn": ["test:static"]
    },
    "test:static": {
      "dependsOn": ["^prep"]
    },
    "test:unit": {
      "dependsOn": ["test:static"]
    },
    "test:integration": {
      "dependsOn": ["test:unit"]
    },
    "precommit": {
      "dependsOn": ["precommit:fix", "precommit:check", "test:unit"]
    },
    "precommit:fix": {
      "dependsOn": ["^prep"]
    },
    "precommit:check": {
      "dependsOn": ["precommit:fix"]
    },
    "drupal:test:static": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:unit": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:integration": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    }
  }
}
