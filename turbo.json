{
  "$schema": "https://turborepo.org/schema.json",
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    // Workaround for https://github.com/jetify-com/devbox/issues/1415
    "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS",
    // Env vars provided by devbox
    "DEVBOX_*",
    "NIX_*",
    "PHP*",
    "NODE_*",
    "HOST_PATH"
  ],
  "globalDependencies": [
    // devbox
    "devbox.json",
    "devbox.lock",
    "devbox.d/**",
    // direnv
    ".envrc",
    // pnpm
    ".npmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["prep"]
    },
    "prep": {
      "dependsOn": ["test:static"]
    },
    "test:static": {
      "dependsOn": ["^prep"]
    },
    "test:unit": {
      "dependsOn": ["test:static"]
    },
    "test:integration": {
      "dependsOn": ["test:unit"]
    },
    "drupal:test:static": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:unit": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:integration": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:static:subdir": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:unit:subdir": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "drupal:test:integration:subdir": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    }
  }
}
