{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "test:static": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "test:unit": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "test:integration": {
      "inputs": [
        "drupal/**/*.php",
        "drupal/**/*.module",
        "drupal/**/*.inc",
        "drupal/**/*.install",
        "drupal/**/*.profile",
        "drupal/**/*.theme",
        "drupal/**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    }
  }
}