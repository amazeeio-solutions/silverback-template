{
  "name": "@custom/seo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "module": "./build/index.js",
  "types": "build/index.d.ts",
  "style": "./build/index.css",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
