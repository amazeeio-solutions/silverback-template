    "yoastseo": "3.0.0"
  },
  "devDependencies": {
    "@custom/eslint-config": "workspace:*",
    "@types/react": "^18.2.46",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.0.0"
  },
