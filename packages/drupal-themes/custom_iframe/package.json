{
  "name": "@custom/custom_iframe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "pnpm --filter @custom/cms precommit:fix packages/drupal-themes/custom_iframe",
    "precommit:check": "pnpm --filter @custom/cms precommit:check packages/drupal-themes/custom_iframe",
    "test:static": "pnpm --filter @custom/cms cms:test:static packages/drupal-themes/custom_iframe",
    "test:unit": "pnpm --filter @custom/cms cms:test:unit --filter=custom_iframe",
    "test:integration": "pnpm --filter @custom/cms cms:test:integration --filter=custom_iframe"
  }
}
