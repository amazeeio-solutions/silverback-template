{
  "name": "@custom/unchained",
  "version": "1.0.0",
  "description": "TypeScript package for communicating with Unchained GraphQL endpoint",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run src/server/server.integration.test.ts --config vitest.integration.config.ts",
    "test:integration:watch": "vitest src/server/server.integration.test.ts --config vitest.integration.config.ts",
    "test:unit": "vitest run --exclude '**/server.integration.test.ts'",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prep": "pnpm run build",
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "gql:introspect": "gql.tada introspect --output ./src/graphql-env.d.ts",
    "gql:validate": "graphql validate",
    "start": "tsx src/server/index.ts",
    "dev:server": "tsx watch src/server/index.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "gql.tada": "^1.8.10",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "memorystore": "^1.6.7",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@custom/eslint-config": "workspace:*",
    "@custom/schema": "workspace:*",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "graphql-cli": "^4.1.0",
    "graphql-config": "^5.1.5",
    "msw": "^2.6.8",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "20",
    "pnpm": "8.15.9"
  }
}
