{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:static": {
      "inputs": [
        "js/**",
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "test:unit": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "test:integration": {
      "inputs": [
        "**/*.php",
        "**/*.module",
        "**/*.inc",
        "**/*.install",
        "**/*.profile",
        "**/*.theme",
        "**/*.info.yml"
      ],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "prep": {
      "inputs": ["js/**"],
      "outputs": ["dist/**"]
    }
  }
}
