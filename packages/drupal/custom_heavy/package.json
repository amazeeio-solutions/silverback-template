{
  "name": "@custom/custom_heavy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:static": "../../../apps/cms/vendor/bin/phpcs --standard=../../../phpcs.xml.dist --error-severity=1 --warning-severity=0 . && ../../../apps/cms/vendor/bin/phpstan analyse --configuration=../../../phpstan.neon --error-format=table --no-progress .",
    "test:unit": "cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --configuration=phpunit.xml.dist --group Unit ../../../packages/drupal/custom_heavy/",
    "test:integration": "cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --configuration=phpunit.xml.dist --exclude-group Unit ../../../packages/drupal/custom_heavy/"
  }
}
