<?php

use Drupal\Core\Entity\ContentEntityInterface;

/**
 * @file
 * Module file for the Search API External module.
 */

function search_api_external_delete_all_external_web_pages() {
  $storage = \Drupal::entityTypeManager()->getStorage('external_web_page');
  $query = $storage->getQuery()->accessCheck(FALSE)->range(0, 1000);
  $ids = $query->execute();
  while (!empty($ids)) {
    $storage->delete($storage->loadMultiple($ids));
    $query = $storage->getQuery()->accessCheck(FALSE)->range(0, 1000);
    $ids = $query->execute();
  }
}

function search_api_external_search_api_datasource_info_alter(array &$infos) {
  if (!empty($infos['entity:external_web_page'])) {
    $infos['entity:external_web_page']['class'] = 'Drupal\search_api_external\Plugin\search_api\datasource\ExternalWebPage';
  }
}

/**
 * Implements hook_silverback_search_live_url_alter().
 */
function search_api_external_silverback_search_live_url_alter(string &$liveUrl, ContentEntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'external_web_page') {
    $liveUrl = $entity->get('url')->value;
  }
}
