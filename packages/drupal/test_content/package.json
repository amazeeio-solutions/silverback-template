{
  "name": "@custom/test_content",
  "private": true,
  "scripts": {
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "pnpm --filter @custom/cms precommit:fix packages/drupal/test_content",
    "precommit:check": "pnpm --filter @custom/cms precommit:check packages/drupal/test_content",
    "test:static": "pnpm --filter @custom/cms cms:test:static packages/drupal/test_content",
    "test:unit": "pnpm --filter @custom/cms cms:test:unit --filter=test_content",
    "test:integration": "pnpm --filter @custom/cms cms:test:integration --filter=test_content"
  }
}
