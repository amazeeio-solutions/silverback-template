{
  "name": "@custom/custom",
  "private": true,
  "scripts": {
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "pnpm --filter @custom/cms precommit:fix packages/drupal/custom",
    "precommit:check": "pnpm --filter @custom/cms precommit:check packages/drupal/custom",
    "test:static": "pnpm --filter @custom/cms cms:test:static packages/drupal/custom",
    "test:unit": "pnpm --filter @custom/cms cms:test:unit --filter=custom",
    "test:integration": "pnpm --filter @custom/cms cms:test:integration --filter=custom"
  }
}
