{
  "name": "@custom/schema",
  "description": "GraphQL schema and operation definitions.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": [
      "./build/index.js"
    ],
    "./source": [
      "./build/generated/source.js"
    ],
    "./operations": [
      "./build/operations.json"
    ],
    "./gatsby-autoload": [
      "./build/gatsby-autoload.mjs"
    ]
  },
  "typesVersions": {
    "*": {
      "": [
        "build/index.d.ts"
      ],
      "/source": [
        "build/generated/source.d.ts"
      ],
      "/gatsby-autoload": [
        "src/types/gatsby-autoload.d.ts"
      ]
    }
  },
  "scripts": {
    "precommit": "pnpm precommit:fix && pnpm precommit:check",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "test:static": "tsc --noEmit && eslint . --quiet",
    "watch": "concurrently \"npm run watch:codegen\" \"npm run watch:swc\" \"npm run watch:tsc\"",
    "watch:codegen": "graphql-codegen --verbose --watch",
    "watch:swc": "swc ./src -d ./build --strip-leading-paths --watch",
    "watch:tsc": "tsc --emitDeclarationOnly --watch",
    "prep": "npm run prep:codegen && npm run prep:scripts && npm run prep:types",
    "prep:codegen": "graphql-codegen",
    "prep:scripts": "swc ./src -d ./build --strip-leading-paths",
    "prep:types": "tsc --emitDeclarationOnly",
    "watcher": "graphql-codegen && tsc --emitDeclarationOnly"
  },
  "devDependencies": {
    "@amazeelabs/codegen-autoloader": "^1.2.3",
    "@amazeelabs/codegen-operation-ids": "workspace:*",
    "@custom/eslint-config": "workspace:*",
    "@graphql-codegen/cli": "^5.0.4",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "^4.1.3",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.67",
    "@types/image-size": "^0.8.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "concurrently": "^9.1.2",
    "gatsby": "^5.14.1",
    "graphql": "16.10.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@amazeelabs/executors": "workspace:*",
    "@amazeelabs/gatsby-silverback-cloudinary": "^1.2.29",
    "@amazeelabs/gatsby-source-silverback": "^1.15.3",
    "@amazeelabs/scalars": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.11",
    "gatsby-plugin-sharp": "5.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "image-size": "^2.0.2",
    "mime-types": "^2.1.35"
  }
}
