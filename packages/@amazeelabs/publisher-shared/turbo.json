{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "inputs": ["src/**", "tsconfig.json", "rollup.config.ts"],
      "outputs": ["dist"]
    },
    "test:static": {
      "inputs": ["src/**", "tsconfig.json", "eslint.config.mjs"]
    },
    "test:unit": {
      "inputs": ["src/**", "tsconfig.json"]
    }
  }
}
