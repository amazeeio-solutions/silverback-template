{
  "name": "@amazeelabs/bridge-react-router",
  "version": "1.0.0",
  "description": "Bridge implementation for react-router.",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "build/client.js",
  "types": "build/dts/client.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./build/dts/server.d.ts",
        "default": "./build/server.js"
      },
      "import": {
        "types": "./build/dts/client.d.ts",
        "default": "./build/client.js"
      }
    }
  },
  "scripts": {
    "prep": "rm -rf build && tsc",
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "test:static": "tsc --noEmit && eslint . --quiet",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react-router": "^7.8.1"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@amazeelabs/bridge": "workspace:*",
    "@custom/eslint-config": "workspace:*",
    "@types/react": "18.3.18",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
