{
  "name": "@amazeelabs/publisher",
  "version": "4.1.1",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/exports.cjs",
  "types": "./dist/exports.d.ts",
  "bin": "./bin/publisher.js",
  "scripts": {
    "prep": "pnpm prep:cli && pnpm prep:exports && pnpm prep:ui",
    "prep:ui": "vite build --config src/ui/vite.config.ts --base=/___status/",
    "watch": "pnpm prep:cli --watch",
    "publisher": "node ./dist/cli.js",
    "start": "nodemon ./dist/cli.js",
    "start:ui": "vite --config src/ui/vite.config.ts",
    "dev": "storybook dev -p 6007 --no-open -c src/ui/.storybook",
    "build-storybook": "storybook build -c src/ui/.storybook",
    "start:storybook": "serve storybook-static -p 6007 > /dev/null 2>&1",
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "pnpm test:static",
    "test:static": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json && eslint . --quiet",
    "test:unit": "vitest run --project server --project ui",
    "test:packaged": "playwright install chromium && vitest run --project packaged",
    "test:storybook": "playwright install chromium && test-storybook --url http://localhost:6007 --config-dir src/ui/.storybook",
    "test:integration": "pnpm test:packaged && start-test start:storybook http://localhost:6007 test:storybook",
    "prep:cli": "node bundle.mjs",
    "prep:exports": "rollup -c rollup.config.ts --configPlugin typescript"
  },
  "dependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@custom/eslint-config": "workspace:*",
    "@headlessui/react": "^2.2.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@react-rxjs/core": "^0.10.8",
    "@rollup/plugin-typescript": "^12.1.2",
    "@slack/webhook": "^7.2.0",
    "@storybook/addon-essentials": "^8.5.2",
    "@storybook/addon-interactions": "^8.5.2",
    "@storybook/addon-links": "^8.5.2",
    "@storybook/react": "^8.5.2",
    "@storybook/react-vite": "^8.5.2",
    "@storybook/test": "^8.5.2",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/react": "^16.2.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/express-ws": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/simple-oauth2": "^5.0.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "http-proxy-middleware": "^3.0.7",
    "http-terminator": "^3.2.0",
    "jsdom": "^25.0.1",
    "memorystore": "^1.6.7",
    "nodemon": "^3.1.9",
    "playwright": "^1.50.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "referrer-policy": "^1.2.0",
    "rollup": "^4.32.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rxjs": "^7.8.1",
    "serve": "^14.2.4",
    "simple-oauth2": "^5.1.0",
    "start-server-and-test": "^2.0.10",
    "storybook": "^8.5.2",
    "strip-ansi": "^7.1.0",
    "sucrase": "^3.35.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "terminate": "^2.8.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
