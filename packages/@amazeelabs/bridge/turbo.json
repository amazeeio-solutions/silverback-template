{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "inputs": ["src/**", "tsconfig.json", ".swcrc"],
      "outputs": ["build"]
    },
    "test:static": {
      "inputs": ["src/**", "tsconfig.json", "eslint.config.mjs"]
    },
    "test:unit": {
      "inputs": ["src/**", "tsconfig.json", "vitest.config.ts"]
    }
  }
}
