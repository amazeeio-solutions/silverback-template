{
  "name": "@amazeelabs/silverback-search",
  "version": "1.3.4",
  "scripts": {
    "test:static": "../../../apps/cms/vendor/bin/phpcs --standard=../../../phpcs.xml.dist --error-severity=1 --warning-severity=0 drupal/ && ../../../apps/cms/vendor/bin/phpstan analyse --configuration=../../../phpstan.neon --error-format=table --no-progress drupal/",
    "test:unit": "cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --configuration=phpunit.xml.dist --group Unit ../../../packages/@amazeelabs/silverback-search/drupal/",
    "test:integration": "cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --configuration=phpunit.xml.dist --exclude-group Unit ../../../packages/@amazeelabs/silverback-search/drupal/"
  },
  "publishConfig": {
    "access": "public"
  }
}
