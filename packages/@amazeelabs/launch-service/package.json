    "@types/node": "^20.11.30",
    "@types/wait-on": "^5.3.4",
    "eslint": "^9.0.0",
    "get-port": "^7.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.7.3",
    "vitest": "^1.4.0"
