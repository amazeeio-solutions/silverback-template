{
  "name": "@amazeelabs/publisher-ui",
  "version": "2.4.22",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite",
    "prep": "vite build --base=/___status/",
    "dev": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "start:storybook": "serve storybook-static -p 6007 > /dev/null 2>&1",
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "test:static": "tsc --noEmit && eslint . --quiet",
    "test:unit": "vitest run --passWithNoTests",
    "test:storybook": "playwright install chromium && test-storybook --url http://localhost:6007",
    "test:integration": "start-test start:storybook http://localhost:6007 test:storybook"
  },
  "devDependencies": {
    "@amazeelabs/publisher-shared": "workspace:*",
    "@custom/eslint-config": "workspace:*",
    "@headlessui/react": "2.2.0",
    "@react-rxjs/core": "0.10.8",
    "@storybook/addon-essentials": "^8.5.2",
    "@storybook/addon-interactions": "^8.5.2",
    "@storybook/addon-links": "^8.5.2",
    "@storybook/react": "^8.5.2",
    "@storybook/react-vite": "^8.5.2",
    "@storybook/test": "^8.5.2",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/react": "16.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "clsx": "2.1.1",
    "jsdom": "25.0.1",
    "playwright": "^1.50.0",
    "postcss": "8.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.1",
    "serve": "^14.2.4",
    "start-server-and-test": "^2.0.10",
    "storybook": "^8.5.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "^3.0.4"
  }
}
