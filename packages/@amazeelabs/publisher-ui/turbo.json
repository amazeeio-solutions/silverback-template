{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "inputs": [
        "src/**",
        "tsconfig.json",
        "vite.config.ts",
        "index.html",
        "tailwind.config.cjs",
        "postcss.config.cjs"
      ],
      "outputs": ["dist"]
    },
    "test:static": {
      "inputs": ["src/**", "tsconfig.json", "eslint.config.mjs"]
    }
  }
}
