{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "inputs": [
        "src/**",
        "static/**",
        "*.html",
        "tailwind.css",
        "tailwind.config.cjs",
        "postcss.config.cjs",
        "vite.config.ts",
        "tsconfig.json"
      ],
      "outputs": ["dist"]
    },
    "test:static": {
      "inputs": [
        "src/**",
        ".storybook/**",
        "tsconfig.json",
        "eslint.config.mjs"
      ]
    },
    "test:unit": {
      "inputs": ["src/**", "tsconfig.json", "vitest.config.ts"]
    },
    "build-storybook": {
      "inputs": [
        "src/**",
        ".storybook/**",
        "static/**",
        "tailwind.css",
        "tailwind.config.cjs",
        "postcss.config.cjs",
        "tsconfig.json"
      ],
      "outputs": ["storybook-static/**"]
    },
    "test:integration": {
      "dependsOn": ["test:unit", "build-storybook"]
    }
  }
}
