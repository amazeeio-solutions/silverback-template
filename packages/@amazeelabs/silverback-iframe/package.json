{
  "name": "@amazeelabs/silverback-iframe",
  "version": "1.7.0",
  "description": "Display Drupal content/forms in iframes.",
  "author": "Amazee Labs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "iframe-resizer-react": "^1.1.1"
  },
  "devDependencies": {
    "@amazeelabs/jest-preset": "^1.3.47",
    "@custom/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/react": "^18",
    "jest": "^29.7.0",
    "react": "^18",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "prep": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "test:static": "tsc --noEmit && eslint . --quiet && ../../../apps/cms/vendor/bin/phpcs --standard=../../../phpcs.xml.dist --error-severity=1 --warning-severity=0 drupal/ && ../../../apps/cms/vendor/bin/phpstan analyse --configuration=../../../phpstan.neon --error-format=table --no-progress drupal/",
    "test:unit": "jest --passWithNoTests && cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit ../../packages/@amazeelabs/silverback-iframe/drupal/tests/Unit/",
    "test:integration": "cd ../../../apps/cms && SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit ../../packages/@amazeelabs/silverback-iframe/drupal/tests/Kernel/",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "react": "^18"
  }
}
