{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "outputs": ["dist"]
    },
    "test:static": {
      "inputs": ["src/**"],
      "dependsOn": ["drupal:test:static:subdir"]
    },
    "test:unit": {
      "dependsOn": ["drupal:test:unit:subdir"]
    },
    "test:integration": {
      "dependsOn": ["drupal:test:integration:subdir"]
    }
  }
}