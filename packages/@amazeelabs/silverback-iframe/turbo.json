{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "prep": {
      "outputs": ["dist"]
    },
    "test:static": {
      "inputs": ["src/**", "drupal/**/*.php", "drupal/**/*.module", "drupal/**/*.inc", "drupal/**/*.install", "drupal/**/*.profile", "drupal/**/*.theme", "drupal/**/*.info.yml"]
    },
    "test:unit": {
      "inputs": ["drupal/**/*.php", "drupal/**/*.module", "drupal/**/*.inc", "drupal/**/*.install", "drupal/**/*.profile", "drupal/**/*.theme", "drupal/**/*.info.yml"],
      "dependsOn": ["@custom/cms#prep:composer"]
    },
    "test:integration": {
      "inputs": ["drupal/**/*.php", "drupal/**/*.module", "drupal/**/*.inc", "drupal/**/*.install", "drupal/**/*.profile", "drupal/**/*.theme", "drupal/**/*.info.yml"],
      "dependsOn": ["@custom/cms#prep:composer"]
    }
  }
}
