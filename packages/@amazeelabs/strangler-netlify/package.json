{
  "name": "@amazeelabs/strangler-netlify",
  "version": "1.2.6",
  "description": "Netlify function for facading legacy systems.",
  "type": "module",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prep": "rm -rf build && swc ./src -d ./build && tsc --emitDeclarationOnly",
    "precommit": "pnpm precommit:fix && pnpm precommit:check && pnpm test:unit",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "test:static": "tsc --noEmit && eslint . --quiet",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@netlify/functions": "^3.0.0"
  },
  "devDependencies": {
    "@custom/eslint-config": "workspace:*",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.10.11",
    "@types/node": "18.19.74",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "keywords": [],
  "author": "AmazeeLabs <development@amazeelabs.com>"
}
