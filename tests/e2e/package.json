{
  "name": "@custom-tests/e2e",
  "type": "module",
  "private": true,
  "scripts": {
    "test:static": "tsc --noEmit && eslint . --quiet",
    "test:integration": "playwright install chromium --with-deps && playwright test",
    "test:headed": "playwright install chromium --with-deps && playwright test --headed",
    "dev": "playwright install chromium --with-deps && playwright test --ui --headed"
  },
  "devDependencies": {
    "@custom/cms": "workspace:*",
    "@custom/decap": "workspace:*",
    "@custom/eslint-config": "workspace:*",
    "@custom/preview": "workspace:*",
    "@custom/website": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^20",
    "typescript": "^5.7.3"
  }
}
