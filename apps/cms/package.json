{
  "name": "@custom/cms",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "description": "Drupal based content management system.",
  "sideEffects": false,
  "scripts": {
    "prep:composer": "if command -v composer; then COMPOSER_ALLOW_SUPERUSER=1 composer install; else echo 'Skipping composer install.'; fi",
    "prep:database": "./prep-database.sh",
    "fix-premissions": "chmod +w web/sites/default/files/.htaccess && chmod +w web/sites/default/files/private/.htaccess",
    "drush": "SB_ENVIRONMENT=1 SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite DRUSH_OPTIONS_URI=http://127.0.0.1:8888 vendor/bin/drush",
    "silverback": "SB_ENVIRONMENT=1 SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite SB_ADMIN_USER=admin SB_ADMIN_PASS=admin vendor/bin/silverback",
    "drupal-install": "SB_SETUP=1 pnpm silverback setup --profile minimal && pnpm content:import && pnpm drush php-eval 'node_access_rebuild();' && rm -rf install-cache.zip && pnpm fix-premissions",
    "export-webforms": "pnpm --filter '@custom/webform-export' webform-snapshots",
    "start": "pnpm start:mailpit && pnpm start:drupal",
    "start:drupal": "cd web; SB_ENVIRONMENT=1 SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite DRUSH_OPTIONS_URI=http://127.0.0.1:8888 php -S 0.0.0.0:8888 .ht.router.php # no drush to avoid the drush server timeout",
    "start:mailpit": "mailpit &",
    "dev": "pnpm start",
    "clear": "pnpm drush cr",
    "login": "pnpm drush uli",
    "content:export": "pnpm drush php-script web/modules/custom/test_content/export.php",
    "content:import": "pnpm drush php-script web/modules/custom/test_content/import.php",
    "config:export": "pnpm drush cex -y",
    "config:import": "pnpm drush -y cim",
    "import-translations": "pnpm drush scr scripts/translations-import.php",
    "cms:fix:phpcs": "vendor/bin/phpcbf --standard=../../phpcs.xml.dist --error-severity=1 --warning-severity=0",
    "cms:test:static": "bash -c 'vendor/bin/phpcs --standard=../../phpcs.xml.dist --error-severity=1 --warning-severity=0 \"../../$@\" && vendor/bin/phpstan analyse --configuration=../../phpstan.neon --error-format=table --no-progress \"../../$@\"' -- ",
    "cms:test:unit": "bash -c 'SB_ENVIRONMENT=1 SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --testsuite=unit \"$@\"' -- ",
    "cms:test:integration": "bash -c 'SB_ENVIRONMENT=1 SIMPLETEST_DB=sqlite://localhost/sites/default/files/.sqlite vendor/bin/phpunit --testsuite=integration \"$@\"' -- "
  },
  "peerDependencies": {
    "@amazeelabs/gatsby-source-silverback": "*"
  },
  "dependencies": {
    "@amazeelabs/silverback-gatsby": "workspace:*",
    "@amazeelabs/silverback-gutenberg": "workspace:*",
    "@amazeelabs/silverback-iframe": "workspace:*",
    "@custom/content_preview": "workspace:*",
    "@amazeelabs/silverback-search": "workspace:^",
    "@custom/custom": "workspace:*",
    "@custom/custom_heavy": "workspace:*",
    "@custom/gutenberg_blocks": "workspace:*",
    "@custom/preview": "workspace:*",
    "@custom/schema": "workspace:*",
    "@custom/search_api_global": "workspace:*",
    "@custom/test_content": "workspace:*",
    "@custom/ui": "workspace:*"
  }
}
