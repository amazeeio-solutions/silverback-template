{
  "extends": ["//"],
  "tasks": {
    "prep": {
      "dependsOn": ["prep:schema"]
    },
    "prep:schema": {
      "dependsOn": ["prep:database"]
    },
    "prep:database": {
      "dependsOn": ["prep:composer", "^prep"],
      "inputs": [
        "prep-database.sh",
        "web/modules/custom/**",
        "web/themes/custom/**"
      ],
      "outputs": ["web/sites/default/files/**"],
      "env": ["CI", "LAGOON", "SKIP_DRUPAL_INSTALL"]
    },
    "config:import": {
      "dependsOn": ["prep:database"],
      "inputs": ["config/**"],
      "outputs": ["web/sites/default/files/.sqlite"]
    },
    "prep:composer": {
      "inputs": [
        "composer.json",
        "composer.lock",
        "scaffold/**",
        "patches/**",
        "node_modules/@amazeelabs/**/drupal/*/composer.json"
      ],
      "outputs": [
        "drush/**",
        "vendor/**",
        "!*/**/.git/**",
        "web/**",
        "!web/modules/custom/**",
        "!web/themes/custom/**",
        "!web/sites/default/files/**"
      ]
    },
    "clear": {
      "dependsOn": ["config:import", "^prep"],
      "cache": false
    }
  }
}
