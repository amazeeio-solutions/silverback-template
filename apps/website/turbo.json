{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "persistent": true,
      "dependsOn": ["^prep"]
    },
    "test:static": {
      "dependsOn": ["^prep"],
      "inputs": ["src/**"]
    },
    "build": {
      "dependsOn": ["^prep"],
      "inputs": [
        "netlify/**",
        "src/**",
        "static/**",
        "netlify.toml",
        "vite.config.js"
      ],
      "outputs": [".netlify/**", "dist/**", ".env"]
    }
  }
}
