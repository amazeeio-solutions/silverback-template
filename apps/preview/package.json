{
  "name": "@custom/preview",
  "private": true,
  "type": "module",
  "scripts": {
    "precommit": "pnpm precommit:fix && pnpm precommit:check",
    "precommit:fix": "eslint . --fix --quiet",
    "precommit:check": "tsc --noEmit && eslint . --quiet",
    "test:static": "tsc --noEmit && eslint . --quiet",
    "dev:app": "vite",
    "dev:server": "tsx watch server/index.ts",
    "prep:app": "vite build",
    "prep:server": "swc ./server -d ./build --strip-leading-paths",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@custom/eslint-config": "workspace:*",
    "@custom/schema": "workspace:*",
    "@custom/ui": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "memorystore": "^1.6.7",
    "node-fetch": "^3.3.2",
    "react": "^18",
    "react-dom": "^18",
    "rxjs": "^7.8.1",
    "simple-oauth2": "^5.1.0",
    "typescript-cookie": "^1.0.6"
  },
  "devDependencies": {
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/express-ws": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/simple-oauth2": "^5.0.7",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
